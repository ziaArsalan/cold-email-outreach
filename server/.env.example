# ─── Google Sheets ───────────────────────────────────────────
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# ─── Google Gemini API (ACTIVE AI provider) ───────────────────
# Used for outreach email intros (aiService) + Upwork cover letters (proposalService).
GEMINI_API_KEY=your_gemini_api_key_here
# Optional. Default: gemini-3-flash-preview. NOTE: gemini-2.5-* models are retired
# for new API keys. Web-search grounding is NOT used — it requires a billed plan
# (free tier returns 429), so prompts forbid inventing company facts.
# GEMINI_MODEL=gemini-3-flash-preview
# Rate-limit resilience (see geminiClient.js): retry 429/503 with capped backoff.
# GEMINI_MAX_RETRIES=4          # attempts before giving up (worker then defers)
# GEMINI_MAX_BACKOFF_MS=30000   # max wait per retry; a bigger server-suggested
#                               # delay (daily quota) makes it give up, not sleep
# AI_INTRO_BATCH_SIZE=15        # leads per request in bulk "regenerate intros"

# ─── Anthropic Claude API (INACTIVE — previous provider) ──────
# Only needed if you restore the commented-out Claude code in
# services/aiService.js + services/proposalService.js (that version used
# Claude's web_search to research each company).
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── SMTP (zia@devtronics.co) ────────────────────────────────
SMTP_HOST=mail.devtronics.co
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=zia@devtronics.co
SMTP_PASS=your_email_password_here
FROM_NAME=Zia Arsalan
FROM_EMAIL=zia@devtronics.co
# SMTP connection/greeting/socket timeout in ms (default 60000). Raise if your
# host is slow or your network drops connections; lower for a fail-fast local dev.
# SMTP_TIMEOUT_MS=60000

# ─── App ─────────────────────────────────────────────────────
PORT=8082

# ─── Upwork Job Monitor ──────────────────────────────────────
GOOGLE_JOBS_SHEET_ID=
UPWORK_JOBS_TAB=Upwork
CRON_INTERVAL=*/10 * * * *
UPWORK_CRON_ENABLED=false
UPWORK_KEYWORDS=GoHighLevel,GHL developer,SaaS development,AI integration developer,loyalty program developer,Next.js developer,React Node.js SaaS,white label SaaS
UPWORK_SOURCE=fixtures
APIFY_API_TOKEN=              # from apify.com → Settings → Integrations
APIFY_ACTOR_ID=neatrat/upwork-job-scraper
APIFY_MAX_RESULTS=25
APIFY_MAPS_ACTOR=compass/crawler-google-places   # Google Maps lead fetch
UPWORK_AUTO_COVER=true        # true = monitor auto-generates cover letters; false = generate from the UI

# ─── Auth ────────────────────────────────────────────────────
AUTH_EMAIL=admin@example.com
AUTH_PASSWORD=change_me
JWT_SECRET=change_me_long_random_string

# ─── Outreach V2 (MongoDB + Queue) ───────────────────────────
# MongoDB Atlas (production target) — paste your Atlas SRV URI; local mongodb://localhost:27017/devtronics-outreach also works
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/devtronics-outreach
# NOTE: The tunables below (QUEUE_WORKER_ENABLED, SEND_MODE, DELAY_*, QUEUE_MAX_RETRIES,
# WORKER_IDLE_MS, EMAIL_VERIFY_*) are now FALLBACK DEFAULTS. When the portal's
# "Outreach Settings" (Settings tab) has a stored value for a field, that value wins;
# these env vars only apply to fields the portal has never overridden.
QUEUE_WORKER_ENABLED=false
SEND_MODE=warmup
# Timezone that defines the "day" for daily send caps + counter resets. Default
# UTC (resets at 00:00 UTC). Set to your local zone so the daily reset lands at
# local midnight, e.g. DAILY_RESET_TZ=Asia/Karachi.
# DAILY_RESET_TZ=UTC
# Reply detection (IMAP). When on, polls each IMAP-enabled mailbox's inbox and
# auto-marks a lead 'replied' (stops their follow-ups) when they reply.
IMAP_WORKER_ENABLED=false
# IMAP_POLL_MS=120000            # how often to poll each mailbox (default 2 min)
# IMAP_DEFAULT_HOST=mail.privateemail.com   # used when a mailbox leaves host blank
# IMAP_DEFAULT_PORT=993
# Public origin used to build the one-click unsubscribe link in every outgoing
# email. MUST be internet-reachable before you send for real — a localhost link
# in a sent email is dead, which blocks opt-outs and hurts deliverability.
PUBLIC_BASE_URL=https://outreach.yourdomain.com
# Optional worker tuning overrides (defaults shown):
# DELAY_WARMUP_MIN_MS=240000
# DELAY_WARMUP_MAX_MS=480000
# DELAY_PROD_MIN_MS=120000
# DELAY_PROD_MAX_MS=300000
# QUEUE_MAX_RETRIES=3
# WORKER_IDLE_MS=30000
# FOLLOWUP_DELAY_UNIT_MS=86400000   # ms per follow-up "day" (shrink for testing)
# Optional pre-send email screening overrides (defaults shown — all 'true'):
# EMAIL_VERIFY_CHECK_MX=true
# EMAIL_VERIFY_BLOCK_DISPOSABLE=true
# EMAIL_VERIFY_BLOCK_ROLE_BASED=true

# ─── Follow-ups module (member task tracking + WhatsApp reminders) ───
# NOTE: provider / throttle / kill-switch / schedule below are FALLBACK DEFAULTS.
# When the Follow-ups "Settings" screen has a stored value, that value wins.
# These are UNRELATED to the campaign follow-up sequences (FOLLOWUP_DELAY_UNIT_MS).
#
# Timezone defining weekly (Mon 00:00) + monthly (1st 00:00) cycle boundaries.
# FOLLOWUPS_TZ=Asia/Karachi
# Default country calling code (digits, no +) for normalizing bare local numbers.
# FOLLOWUPS_DEFAULT_CC=92
# Active reminder channel: wa_link (zero-setup click-to-send) or whatsapp_cloud.
# REMINDER_PROVIDER=wa_link
# Don't re-remind the same member within this many hours (unless forced).
# FOLLOWUP_THROTTLE_HOURS=24
# Master kill switch for the SCHEDULED auto-reminder job (manual sends always work).
# FOLLOWUP_AUTO_REMINDERS=false
# Scheduled nudges — 'day HH:MM' local time. Blank disables that nudge.
# FOLLOWUP_SCHEDULE_PRIMARY=mon 10:00
# FOLLOWUP_SCHEDULE_SECONDARY=
#
# ── WhatsApp Business Cloud API (only for REMINDER_PROVIDER=whatsapp_cloud) ──
# Secrets/infra — env ONLY, never stored in the Settings singleton or any API response.
# WHATSAPP_TOKEN=your_permanent_access_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_TEMPLATE_NAME=followup_reminder     # an APPROVED template; body = {{1}} name, {{2}} task list
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_GRAPH_VERSION=v21.0
# Inbound "DONE" webhook (optional):
# WHATSAPP_WEBHOOK_ENABLED=false
# WHATSAPP_VERIFY_TOKEN=a_random_string_you_also_enter_in_meta
# WHATSAPP_APP_SECRET=your_meta_app_secret    # used to verify X-Hub-Signature-256
